# Rust
daemon/target/
**/*.rs.bk

# Flutter / Dart
app/build/
app/.dart_tool/
app/.flutter-plugins-dependencies
app/packages/ui/.dart_tool/

# Generated code (regenerated by `make proto`)
app/lib/core/ipc/generated/

# Python bytecode. The demo helpers under tests/e2e are scripts, not modules,
# so a plain run writes none; importing or byte-compiling one does.
__pycache__/
*.pyc

# Local data
*.db
*.db-wal
*.db-shm
target/escape/
target/e2e/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Arbeitsbäume und Zwischenstände der KI-Agenten; nie Teil eines Commits.
.claude/
