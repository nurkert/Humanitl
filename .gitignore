# Rust
daemon/target/
**/*.rs.bk

# Flutter / Dart
app/build/
app/.dart_tool/
app/.flutter-plugins-dependencies
app/packages/ui/.dart_tool/
# Differenzbilder eines roten Golden-Vergleichs; der CI-Job `goldens` lädt
# sie als Artefakt hoch. Plattform-Goldens mit echten Schriften bleiben lokal
# (HUM-054): eingecheckt wird nur der CI-Modus unter `goldens/ci/`.
app/test/goldens/failures/
**/goldens/platform/

# Generated code (regenerated by `make proto`)
app/lib/core/ipc/generated/

# Python bytecode. The demo helpers under tests/e2e are scripts, not modules,
# so a plain run writes none; importing or byte-compiling one does.
__pycache__/
*.pyc

# Local data
*.db
*.db-wal
*.db-shm
target/escape/
target/e2e/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Arbeitsbäume und Zwischenstände der KI-Agenten; nie Teil eines Commits.
.claude/

# Daemon, Kommandozeile und Shim fuer das Flutter-Bundle, von `make package`
# dorthin gelegt (HUM-053); gebaut, nie eingecheckt.
app/linux/bundle-extra/
# Ausgabe von `make package`.
dist/
