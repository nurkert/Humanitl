---
// Die Liste aller Docs-Seiten in Gruppen, für die Seitenleiste und das Menü auf dem Telefon.
// Eine Seite, die in dieser Sprache nur im Original vorliegt, trägt das Kürzel der Sprache,
// in der sie geschrieben ist (HUM-346).
import { ui } from '../../i18n/ui';
import type { DocGroup } from '../../lib/docs';

interface Props {
  groups: DocGroup[];
  currentId?: string;
  lang?: 'de' | 'en';
}

const { groups, currentId, lang = 'en' } = Astro.props;
const t = ui[lang].docs;
---

<div class="dnav">
  {
    groups.map((group) => {
      const hasCurrent = group.items.some((item) => item.id === currentId);
      // Die lange Liste der Entscheidungen bleibt zu, solange man nicht darin liest.
      const open = group.key !== 'decisions' || hasCurrent;
      return (
        <details class="dnav__group" open={open} data-group={group.key}>
          <summary class="dnav__title">{t.groupTitles[group.key as keyof typeof t.groupTitles] ?? group.key}</summary>
          <ul class="dnav__list">
            {group.items.map((item) => (
              <li>
                <a
                  class:list={['dnav__link', { 'dnav__link--adr': item.number }]}
                  href={item.href}
                  aria-current={item.id === currentId ? 'page' : undefined}
                >
                  {item.number && <span class="dnav__num">{item.number}</span>}
                  <span class="dnav__label" lang={item.number ? item.contentLang : undefined}>{item.label}</span>
                  {item.kind === 'missing' && (
                    <span class="badge" aria-hidden="true">
                      {item.contentLang.toUpperCase()}
                    </span>
                  )}
                  {item.kind === 'missing' && (
                    <span class="visually-hidden">({t.otherLanguage[item.contentLang]})</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </details>
      );
    })
  }
</div>
