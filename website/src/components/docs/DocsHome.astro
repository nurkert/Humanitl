---
// Startseite der Dokumentation in einer Sprache (HUM-336, zweisprachig seit HUM-346), aus
// docs/README.md oder ihrer Übersetzung: dieselben Gruppen, je Seite eine Karte mit der Zeile
// „What it answers" aus der README-Tabelle.
import { getCollection, render } from 'astro:content';

import Base from '../../layouts/Base.astro';
import { ui } from '../../i18n/ui';
import { docAlternates, docGroups, docHref, repoUrl, resolveVersion, translationIndex, type DocLang } from '../../lib/docs';
import DocNotice from './DocNotice.astro';
import '../../styles/docs.css';

interface Props {
  lang: DocLang;
}

const { lang } = Astro.props;
const t = ui[lang].docs;
const entries = await getCollection('docs');
const translations = await getCollection('translations');
const groups = docGroups(entries, translations, lang).filter((group) => group.key !== 'start');

// Die Abschnitte tragen die IDs der Überschriften aus docs/README.md (`#using-humanitl` usw.),
// damit Sprungmarken, die auf GitHub funktionieren, auch hier landen, in beiden Sprachen.
// Zugeordnet über den Anfang des Slugs; ohne Treffer bleibt der Gruppenschlüssel.
const readme = entries.find((entry) => entry.id === 'readme');
const readmeHeadings = readme ? (await render(readme)).headings.filter((heading) => heading.depth === 2) : [];
const sectionId = (key: string) => readmeHeadings.find((heading) => heading.slug.startsWith(key))?.slug ?? key;

// Der Einleitungsabsatz der README in der Sprache der Seite (nach „Applies to", vor der ersten
// H2), Zeichen für Zeichen; nur `*kursiv*` und `Code` werden ausgezeichnet, alles andere maskiert.
const readmeVersion = readme ? resolveVersion(readme, lang, translationIndex(translations)) : undefined;
const escapeHtml = (value: string) => value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const intro = (readmeVersion?.entry.body ?? '')
  .split(/\n## /)[0]
  .split(/\n\s*\n/)
  .map((block) => block.trim())
  .filter((block) => block && !block.startsWith('#') && !block.startsWith('<!--') && !/^Applies to:/.test(block))
  .map((block) =>
    escapeHtml(block.replace(/\s*\n\s*/g, ' '))
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\*([^*]+)\*/g, '<em>$1</em>'),
  );
const introLang = readmeVersion?.contentLang ?? lang;
const statusLabel = (value: string) => {
  const word = value.split(/\s/)[0].replace(/\|$/, '');
  return t.status[word.toLowerCase() as keyof typeof t.status] ?? word;
};
---

<Base lang={lang} alternates={docAlternates('readme')} title={`${t.title} · Humanitl Docs`} description={t.lede}>
  <main id="main" class="dhome container">
    <header class="dhome__head">
      <h1 class="chrome dhome__title">{t.title}</h1>
      <p class="dhome__lede">{t.lede}</p>
      {
        readmeVersion && intro.length > 0 && (
          <DocNotice
            lang={lang}
            kind={readmeVersion.kind}
            stale={readmeVersion.stale}
            originalHref={docHref('readme', readmeVersion.originalLang)}
            originalLang={readmeVersion.originalLang}
          />
        )
      }
      {intro.map((html) => <p class="dhome__intro" lang={introLang} set:html={html} />)}
      <p class="dhome__meta">
        <span>{entries.length} {t.pages}</span>
        <span aria-hidden="true">·</span>
        <span>{t.appliesTo}</span>
        <span aria-hidden="true">·</span>
        <a href={`${repoUrl}/tree/main/docs`}>{t.sourceOnGitHub}</a>
      </p>
    </header>

    {
      groups.map((group) => (
        <section class="dgroup" aria-labelledby={sectionId(group.key)}>
          <div class="dgroup__head">
            <h2 id={sectionId(group.key)}>{t.groupTitles[group.key as keyof typeof t.groupTitles] ?? group.key}</h2>
            <span class="dgroup__n">{group.items.length}</span>
          </div>
          {t.groups[group.key as keyof typeof t.groups] && (
            <p class="dgroup__lede">{t.groups[group.key as keyof typeof t.groups]}</p>
          )}
          {group.key === 'decisions' ? (
            <ul class="adrs">
              {group.items.map((item) => (
                <li>
                  <a class="adrs__row" href={item.href}>
                    <span class="adrs__num">{item.number || '—'}</span>
                    <span class="adrs__label" lang={item.contentLang}>
                      {item.number ? item.label : item.title}
                      {(item.kind === 'missing' || item.stale) && ' '}
                      {item.kind === 'missing' && (
                        <span class="badge" lang={lang} title={t.notTranslatedTitle}>
                          {item.contentLang.toUpperCase()}
                        </span>
                      )}
                      {item.stale && (
                        <span class="badge" lang={lang}>
                          {t.staleBadge}
                        </span>
                      )}
                    </span>
                    {item.status && (
                      <span class="chip" data-status={item.status.split(/\s/)[0].toLowerCase()}>
                        {statusLabel(item.status)}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <ul class="cards">
              {group.items.map((item) => (
                <li>
                  <a class="card" href={item.href}>
                    <span class="card__title">{item.label}</span>
                    <span class="card__sum">{item.summary}</span>
                    <span class="card__foot">
                      <span>{item.source}</span>
                      {item.kind === 'missing' && (
                        <span class="badge" title={t.notTranslatedTitle}>
                          {item.contentLang.toUpperCase()}
                        </span>
                      )}
                      {item.stale && <span class="badge">{t.staleBadge}</span>}
                      {item.generated && <span class="badge">{t.generated}</span>}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </main>
</Base>
