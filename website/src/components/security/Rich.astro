---
// Fließtext aus den Locales: `Backticks` werden zu <code>, alles andere wird maskiert.
// Mit `fnHref` wird jede hochgestellte Eins (¹) zu einem Verweis auf die Fußnote (HUM-472).
interface Props {
  text: string;
  tag?: string;
  class?: string;
  fnHref?: string;
  fnLabel?: string;
}
const { text, tag = 'span', class: cls, fnHref, fnLabel = '' } = Astro.props;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
let html = esc(text).replace(/`([^`]+)`/g, '<code>$1</code>');
if (fnHref) html = html.replace(/¹/g, `<a class="fnref" href="${esc(fnHref)}" aria-label="${esc(fnLabel)}">¹</a>`);
const Tag = tag as any;
---

<Tag class={cls} set:html={html} />
