---
// Diagramm J: der Weg einer Anfrage. Das Markup zeigt den vollständigen Endzustand
// (data-beat="all"); das Skript schaltet die Beats 1 bis 7 je nach gelesenem Schritt.
interface Props {
  s: any;
  k: any;
}
const { s, k } = Astro.props;
const f = s.path.fig;
const fakes = [
  { y: 150, t: 'X11' },
  { y: 195, t: 'D-Bus' },
  { y: 240, t: 'docker.sock' },
  { y: 375, t: '~/.ssh' },
  { y: 420, t: 'daemon.sock' },
];
const tiles = ['UNIX', 'NETLINK', 'PACKET', 'VSOCK', 'DGRAM', 'RAW', 'TCP'];
const ghosts = [
  { x: 270, y: 128 },
  { x: 112, y: 305 },
  { x: 380, y: 484 },
];
const hits = [
  { x: 160, y: 106, w: 200, h: 8 },
  { x: 36, y: 230, w: 8, h: 150 },
  { x: 280, y: 496, w: 200, h: 8 },
];
const wallLabels = [
  { x: 268, y: 172, t: 'ENETUNREACH' },
  { x: 58, y: 222, t: 'EPERM' },
  { x: 330, y: 450, t: 'ENETUNREACH' },
];
const ticks = Array.from({ length: 12 }, (_, i) => i);
const pkt = (cls: string) => (
  `<rect x="-100" y="-17" width="200" height="34" rx="17" class="j-pkt-body"></rect>` +
  (cls === 'main' ? `<rect x="-100" y="-17" width="200" height="34" rx="17" class="j-pkt-held"></rect>` : '') +
  `<text x="0" y="5" text-anchor="middle" class="sv-lbl sv-lbl--pkt">${k.packet}</text>`
);
---

<svg class="sec-j" viewBox="0 0 1200 760" role="img" aria-labelledby="j-t j-d">
  <title id="j-t">{s.path.figTitle}</title>
  <desc id="j-d">{s.path.figDesc}</desc>
  <defs>
    <pattern id="j-dots" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="10" cy="10" r="1.4" fill="currentColor"></circle>
    </pattern>
    <filter id="j-blur" x="-80%" y="-120%" width="260%" height="340%">
      <feGaussianBlur stdDeviation="12"></feGaussianBlur>
    </filter>
  </defs>
  <g class="j-cam" aria-hidden="true">
    <g class="j-l j-net">
      <rect class="j-dots" x="980" y="120" width="190" height="380" fill="url(#j-dots)"></rect>
      <text x="980" y="534" class="sv-lbl sv-lbl--l">{f.net}</text>
      <g class="j-dns">
        <rect x="1040" y="136" width="70" height="32" rx="9"></rect>
        <text x="1075" y="158" text-anchor="middle" class="sv-lbl sv-lbl--m">DNS</text>
      </g>
    </g>

    <g class="j-l j-llm">
      <path class="j-llm-path" d="M500 296 H600 V366 H858 V95 H1070 V120"></path>
      <text x="556" y="84" class="j-llm-lbl sv-lbl sv-lbl--s">{f.llm}</text>
    </g>

    <g class="j-l j-audit">
      <text x="620" y="18" class="sv-lbl sv-lbl--d" data-detail>audit.jsonl</text>
      <g class="j-blks">
        {Array.from({ length: 7 }, (_, i) => <rect class="j-blk" x={620 + 60 * i} y="28" width="52" height="24" rx="4" />)}
      </g>
      <rect class="j-blk j-blk-new" x="1040" y="28" width="52" height="24" rx="4"></rect>
    </g>

    <g class="j-l j-box">
      <rect class="sv-fill" x="40" y="110" width="460" height="390" rx="28"></rect>
      <path class="sv-wall" d="M500 280 V138 A28 28 0 0 0 472 110 H68 A28 28 0 0 0 40 138 V472 A28 28 0 0 0 68 500 H472 A28 28 0 0 0 500 472 V330"></path>
      <text x="66" y="152" class="sv-lbl sv-lbl--l">sandbox</text>
      <circle class="j-agent-ring" cx="220" cy="305" r="30"></circle>
      <circle class="sv-agent" cx="220" cy="305" r="16"></circle>
      <text x="220" y="262" text-anchor="middle" class="sv-lbl sv-lbl--m">agent</text>
    </g>

    <g class="j-l j-work">
      <path class="j-folder" d="M70 482 h28 l8 8 h44 v36 h-80 z"></path>
      <text x="66" y="470" class="sv-lbl sv-lbl--m">{f.work}</text>
    </g>

    <g class="j-l j-walls">
      {hits.map((h) => <rect class="j-hit" x={h.x} y={h.y} width={h.w} height={h.h} rx="4" />)}
      {
        wallLabels.map((w, i) => (
          <text class="j-wlbl sv-lbl sv-lbl--deny sv-lbl--m" x={w.x} y={w.y} style={`--i:${i}`}>
            {w.t}
          </text>
        ))
      }
    </g>

    <g class="j-l j-fakes">
      {
        fakes.map((d, i) => (
          <g class="j-fake" style={`--i:${i}`}>
            <rect x="493" y={d.y - 11} width="14" height="22" rx="3" />
            <path d={`M489 ${d.y + 13} L511 ${d.y - 13}`} />
            <text x="482" y={d.y + 5} text-anchor="end" class="sv-lbl sv-lbl--d" data-detail>
              {d.t}
            </text>
          </g>
        ))
      }
    </g>

    <g class="j-l j-door">
      <ellipse class="j-door-light" cx="522" cy="305" rx="38" ry="22" filter="url(#j-blur)"></ellipse>
      <rect class="j-door-frame" x="497" y="280" width="6" height="50" rx="2"></rect>
      <text class="j-door-lbl sv-lbl sv-lbl--d" x="488" y="346" text-anchor="end" data-detail>127.0.0.1:3128 → proxy.sock</text>
    </g>

    <g class="j-l j-floor">
      {
        tiles.map((t, i) => (
          <g class={i === 6 ? 'j-tile j-tile--ok' : 'j-tile'} style={`--i:${i}`}>
            <rect x={40 + 66 * i} y="540" width="60" height="46" rx="7" />
            <text x={70 + 66 * i} y="559" text-anchor="middle" class="sv-lbl sv-lbl--t">
              {t}
            </text>
            {i < 6 ? (
              <text x={70 + 66 * i} y="578" text-anchor="middle" class="j-stamp sv-lbl sv-lbl--t" style={`--i:${i}`}>
                EPERM
              </text>
            ) : (
              <text x={70 + 66 * i} y="578" text-anchor="middle" class="sv-lbl sv-lbl--t sv-lbl--ok">
                ok
              </text>
            )}
          </g>
        ))
      }
      <rect class="j-void" x="500" y="562" width="80" height="2"></rect>
      <text x="40" y="624" class="sv-lbl sv-lbl--l">seccomp</text>
      <text x="580" y="612" text-anchor="end" class="j-void-lbl sv-lbl sv-lbl--m">{f.void}</text>
    </g>

    <g class="j-l j-lock">
      <rect class="sv-fill sv-lock" x="580" y="150" width="290" height="330" rx="44"></rect>
      <text x="604" y="186" class="sv-lbl sv-lbl--l">humanitld</text>
      <text x="850" y="182" text-anchor="end" class="sv-lbl sv-lbl--dim j-rules-lbl" data-detail>{f.rules}</text>
      {
        k.rules.map((r: string, i: number) => (
          <text class={i === 2 ? 'j-rule j-rule--ask sv-lbl sv-lbl--r' : 'j-rule sv-lbl sv-lbl--r'} x="604" y={214 + 22 * i} style={`--i:${i}`}>
            {r}
          </text>
        ))
      }
      <circle class="j-hold" cx="725" cy="305" r="44"></circle>
      <circle class="j-hold-pulse" cx="725" cy="305" r="44"></circle>
      <g class="j-timer">
        <circle cx="640" cy="388" r="12"></circle>
        {
          ticks.map((i) => (
            <rect class="j-tick" x="639" y="364" width="2" height="7" transform={`rotate(${i * 30} 640 388)`} style={`--i:${i}`} />
          ))
        }
        <text x="668" y="394" class="sv-lbl sv-lbl--m">300 s</text>
      </g>
      <text x="604" y="436" class="sv-lbl sv-lbl--m">{k.host}</text>
      <text x="604" y="460" class="j-host j-host--un sv-lbl sv-lbl--r">{f.unresolved}</text>
      <text x="604" y="460" class="j-host j-host--re sv-lbl sv-lbl--r">{f.resolved}</text>
    </g>

    <g class="j-l j-human">
      <rect class="j-link" x="724" y="480" width="2" height="80"></rect>
      <g class="j-panel">
        <rect class="sv-fill" x="590" y="560" width="270" height="140" rx="22"></rect>
        <text x="612" y="596" class="sv-lbl sv-lbl--l">{f.human}</text>
        {
          f.buttons.map((b: string, i: number) => (
            <g class={`j-btn j-btn--${i}`}>
              <rect x={602 + 82 * i} y="616" width="76" height="40" rx="10" />
              {i === 0 && <rect class="j-btn-ring" x="602" y="616" width="76" height="40" rx="10" />}
              <text x={640 + 82 * i} y="641" text-anchor="middle" class="sv-lbl sv-lbl--b">
                {b}
              </text>
            </g>
          ))
        }
      </g>
    </g>

    <g class="j-l j-up">
      <rect class="j-upline" x="870" y="304" width="105" height="2"></rect>
      <path class="j-uphead" d="M974 298 L986 305 L974 312 Z"></path>
    </g>

    <g class="j-ghosts">
      {
        ghosts.map((g) => (
          <g class="j-ghost" style={`--gx:${g.x}px;--gy:${g.y}px`}>
            <g class="j-ghost-in" set:html={pkt('ghost')} />
          </g>
        ))
      }
    </g>

    <g class="j-pkt-x">
      <g class="j-pkt-y">
        <g class="j-pkt" set:html={pkt('main')} />
      </g>
    </g>
  </g>
</svg>
