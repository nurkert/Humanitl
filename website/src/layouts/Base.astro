---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';

import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { alternates, defaultLang, languages, path, repoUrl, ui, type Lang, type Page } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Fehlt bei Seiten außerhalb von `pages` (die Docs); die geben ihre Sprachfassungen über `alternates`. */
  page?: Page;
  /**
   * Sprachfassungen einer Seite ohne `page` (die Docs, HUM-346), für hreflang und die
   * Sprachwahl. Fehlen beide, gibt es keine hreflang-Paare und keine Sprachwahl.
   */
  alternates?: { lang: Lang; href: string }[];
  /**
   * Sprache des Haupttextes, wenn sie von `lang` abweicht (eine Docs-Seite ohne Übersetzung,
   * HUM-346): `<html lang>` nennt sie, Kopf- und Fußzeile behalten `lang` als eigenes Attribut.
   */
  contentLang?: Lang;
  title: string;
  description: string;
}

const { lang, page, title, description, alternates: pageAlternates, contentLang = lang } = Astro.props;
const chromeLang = contentLang !== lang ? lang : undefined;
const t = ui[lang];
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const versions = page ? alternates(page) : (pageAlternates ?? []);
const xDefault = versions.find((version) => version.lang === defaultLang);
// Die Docs je Sprache: /docs/ auf Deutsch, /en/docs/ auf Englisch (HUM-346). Darunter ist der
// Docs-Link aktiv; auf der Startseite der Docs als genau diese Seite.
const docsHome = lang === defaultLang ? '/docs/' : `/${lang}/docs/`;
const docsCurrent = Astro.url.pathname === docsHome ? 'page' : Astro.url.pathname.startsWith(docsHome) ? 'true' : undefined;
const home = path('home', lang);

const nav = [
  { href: `${home}#module`, label: t.nav.how },
  { href: path('security', lang), label: t.nav.security, current: page === 'security' ? 'page' : undefined },
  { href: docsHome, label: t.nav.docs, current: docsCurrent },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Humanitl',
  url: site.toString(),
  description: ui[lang].meta.description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: ['macOS', 'Linux'],
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  codeRepository: repoUrl,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  image: new URL('/og.jpg', site).toString(),
};
---

<!doctype html>
<html lang={contentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" data-scheme="dark" content="#030405" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" data-scheme="light" content="#f3f4f7" />
    {/* Blockierend und extern: Die CSP verbietet Inline-Skripte, das Thema muss vor dem ersten Bild stehen (HUM-338). */}
    <script is:inline src="/theme.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {versions.map((version) => <link rel="alternate" hreflang={version.lang} href={new URL(version.href, site)} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault.href, site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Humanitl" />
    <meta property="og:locale" content={languages[lang].og} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg', site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main" lang={chromeLang}>{lang === 'de' ? 'Zum Inhalt' : 'Skip to content'}</a>
    <header class="nav" data-nav lang={chromeLang}>
      <div class="nav__bar">
        <a class="nav__brand" href={home} aria-label={t.nav.home}>
          <Logo />
          <span>Humanitl</span>
        </a>
        <nav class="nav__links" aria-label={t.nav.menu}>
          {
            nav.map((item) => (
              <a href={item.href} aria-current={item.current}>
                {item.label}
              </a>
            ))
          }
          <a href={repoUrl} class="nav__gh">
            <Icon name="github" />
            <span>GitHub</span>
          </a>
        </nav>
        <div class="nav__end">
          {
            versions.length > 0 && (
              <ul class="nav__lang" aria-label={t.nav.language}>
                {versions.map((version) => (
                  <li>
                    <a
                      href={version.href}
                      hreflang={version.lang}
                      lang={version.lang}
                      aria-current={version.lang === lang ? 'true' : undefined}
                      title={languages[version.lang].label}
                    >
                      {languages[version.lang].short}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
          <button
            class="theme"
            type="button"
            data-theme-toggle
            data-label-light={t.nav.themeLight}
            data-label-dark={t.nav.themeDark}
            aria-label={t.nav.themeLight}
          >
            <span class="theme__icon theme__icon--sun"><Icon name="sun" /></span>
            <span class="theme__icon theme__icon--moon"><Icon name="moon" /></span>
          </button>
          <a class="pill pill--small" href={path('download', lang)} aria-current={page === 'download' ? 'page' : undefined}>
            {t.nav.download}
          </a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="foot" lang={chromeLang}>
      <div class="container foot__row">
        <a class="nav__brand" href={home} aria-label={t.nav.home}>
          <Logo />
          <span>Humanitl</span>
        </a>
        <p class="foot__line">{t.footer.line}</p>
        <nav class="foot__links" aria-label={t.legal.imprint}>
          <a href={path('download', lang)}>{t.nav.download}</a>
          <a href={docsHome}>{t.nav.docs}</a>
          <a href={repoUrl}>{t.footer.github}</a>
          <a href={path('imprint', lang)}>{t.legal.imprint}</a>
          <a href={path('privacy', lang)}>{t.legal.privacy}</a>
        </nav>
      </div>
    </footer>
    <script>
      import '../scripts/nav';
    </script>
  </body>
</html>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 0.9rem var(--gutter) 0;
    pointer-events: none;
  }
  .nav__bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: min(100%, var(--max));
    margin-inline: auto;
    padding: 0.55rem 0.6rem 0.55rem 0.9rem;
    border-radius: 999px;
    border: 1px solid transparent;
    transition:
      background 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }
  /* Erst nach dem ersten Stück Scrollen bekommt die Leiste ihren Glaskörper. */
  :global(.nav[data-scrolled]) .nav__bar {
    background: var(--nav-glass);
    border-color: var(--line);
    box-shadow:
      0 20px 50px -24px rgb(var(--shadow) / calc(0.9 * var(--shadow-k))),
      inset 0 1px 0 rgb(255 255 255 / 0.06);
    backdrop-filter: blur(18px) saturate(1.3);
  }
  /* Der Minifier behält je Regel nur einen der beiden Namen, darum steht der Präfix für
     Safari vor 18 in einer eigenen Regel. */
  @supports not (backdrop-filter: blur(1px)) {
    :global(.nav[data-scrolled]) .nav__bar {
      -webkit-backdrop-filter: blur(18px) saturate(1.3);
    }
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .nav__brand :global(svg) {
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    filter: drop-shadow(0 4px 14px rgb(232 184 75 / 0.25));
  }
  .nav__links {
    display: flex;
    gap: 1.6rem;
    margin-left: auto;
    font-size: 0.92rem;
  }
  .nav__links a {
    display: inline-flex;
    white-space: nowrap;
    align-items: center;
    gap: 0.4rem;
    color: var(--fg-1);
    text-decoration: none;
    transition: color 0.3s var(--ease-out);
  }
  .nav__links a:hover,
  .nav__links a[aria-current] {
    color: var(--fg);
  }
  .nav__links :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  .nav__end {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .nav__lang {
    display: flex;
    gap: 0.15rem;
    margin: 0;
    padding: 0.2rem;
    list-style: none;
    border-radius: 999px;
    border: 1px solid var(--line);
    font: 500 0.72rem/1 var(--mono);
  }
  .nav__lang a {
    display: block;
    padding: 0.38rem 0.5rem;
    border-radius: 999px;
    color: var(--fg-2);
    text-decoration: none;
  }
  .nav__lang a[aria-current] {
    background: rgb(var(--ink) / 0.1);
    color: var(--fg);
  }
  /* Ohne Skript gibt es keinen Umschalter: das System entscheidet. */
  .theme {
    display: none;
    flex: none;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--fg-1);
    cursor: pointer;
    transition:
      color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
  }
  :global(:root[data-theme-js]) .theme {
    display: grid;
  }
  .theme:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }
  .theme:active {
    transform: scale(0.94);
  }
  .theme__icon :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
  /* Das Symbol nennt das Ziel: im Dunkeln die Sonne, im Hellen der Mond. */
  .theme__icon--sun {
    display: var(--dark, block) var(--light, none);
  }
  .theme__icon--moon {
    display: var(--dark, none) var(--light, block);
  }
  @media (max-width: 54rem) {
    .nav__links {
      display: none;
    }
    .nav__end {
      margin-left: auto;
    }
  }
  /* Telefone: Sprachwahl, Umschalter und Download brauchen die Breite, die Marke das Zeichen. */
  @media (max-width: 26rem) {
    .nav__bar {
      gap: 0.6rem;
      padding-inline: 0.6rem 0.45rem;
    }
    .nav__end {
      gap: 0.45rem;
    }
    .nav__end .pill--small {
      padding: 0 0.85rem;
    }
    .theme {
      width: 2.25rem;
      height: 2.25rem;
    }
  }
  @media (max-width: 23.75rem) {
    .nav__bar .nav__brand span {
      display: none;
    }
  }

  .foot {
    position: relative;
    border-top: 1px solid var(--line);
    padding: 2.5rem 0 3rem;
    color: var(--fg-2);
    font-size: 0.88rem;
  }
  .foot__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }
  .foot .nav__brand {
    color: var(--fg);
  }
  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin-left: auto;
  }
  .foot__links a {
    text-decoration: none;
  }
  .foot__links a:hover {
    color: var(--fg);
  }
</style>
