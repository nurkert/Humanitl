  "shellNavSetup": "Setup",
  "@shellNavSetup": {"description": "Sixth entry of the icon rail (Ctrl+6): the four checks that come before an agent starts (HUM-044)."},
  "setupIntro": "Every line below is the daemon''s answer about this machine, not a guess.",
  "@setupIntro": {"description": "The sentence under the title of the setup screen. It says where the verdicts come from, because the whole screen is a claim about somebody's machine (ADR-018)."},
  "setupCheckDaemon": "Background service",
  "@setupCheckDaemon": {"description": "Heading of the first setup row: does humanitld answer on its socket?"},
  "setupCheckLlm": "Your model server",
