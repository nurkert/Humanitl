  },
  "setupDoctorEmpty": "The daemon sent no line about this machine.",
  "@setupDoctorEmpty": {"description": "Stands in place of the doctor list when the report carries no line at all. Not the same as a green machine: nothing was asked."},
  "setupLlmEndpointLabel": "Address of the model server",
