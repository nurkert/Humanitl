    "placeholders": {"endpoint": {"type": "String"}, "models": {"type": "int"}, "ms": {"type": "int"}}
  },
  "setupLlmMoreModels": "+{count} more",
  "@setupLlmMoreModels": {
    "description": "Last chip of the model list. The names come from a server on the LAN, so only a few are drawn; this says how many were left out.",
    "placeholders": {"count": {"type": "int"}}
  },
  "setupLlmDiscoverOpen": "Find one",
  "@setupLlmDiscoverOpen": {"description": "The second button of the model row. It opens the sheet that searches the local network; it starts no search by itself (HUM-076)."},
  "setupLlmDiscoverTitle": "Find a model server",
  "@setupLlmDiscoverTitle": {"description": "Heading of the search sheet."},
  "setupLlmDiscoverExplain": "Searches the local network for model servers. Sends connection attempts to ports {ports}, and nothing else: nothing is written, no credentials are sent, and the search stays inside your own /24.",
  "@setupLlmDiscoverExplain": {
    "description": "The sentence above the search button. A network scan is explained before it happens, never after (HUM-076).",
    "placeholders": {"ports": {"type": "String"}}
  },
  "setupLlmDiscoverStart": "Search",
  "@setupLlmDiscoverStart": {"description": "The button that starts the network search. Nothing is contacted before it is pressed."},
  "setupLlmDiscoverRunning": "{count, plural, =0{Searching…} =1{Searching… 1 server so far} other{Searching… {count} servers so far}}",
  "@setupLlmDiscoverRunning": {
    "description": "The line while the search runs. It counts what answered instead of showing a percentage: the daemon streams answers, not progress.",
