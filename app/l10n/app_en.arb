  },
  "setupStartUnmeasured": "{count, plural, =1{1 check of this machine could not be measured, so its row is not green. Check again above, then this button turns on.} other{{count} checks of this machine could not be measured, so their row is not green. Check again above, then this button turns on.}}",
  "@setupStartUnmeasured": {
