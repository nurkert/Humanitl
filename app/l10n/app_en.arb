  "setupLlmEndpointHint": "http://192.168.1.10:11434",
  "@setupLlmEndpointHint": {"description": "Placeholder of the endpoint field: an address in a private network, which is the only kind that belongs here."},
  "setupLlmProbe": "Contact it",
  "@setupLlmProbe": {"description": "The button that opens the connection to the model server. It is labelled for what it does and not for saving: nothing is contacted while somebody types (HUM-044)."},
  "setupLlmMeasured": "{endpoint} answered with {models} models in {ms} ms",
  "@setupLlmMeasured": {
