    "placeholders": {"count": {"type": "int"}}
  },
  "setupLlmDiscoverEmpty": "Ollama listens on localhost only unless OLLAMA_HOST=0.0.0.0 is set. A server on another port is not found by this search.",
  "@setupLlmDiscoverEmpty": {"description": "The hint under an empty result. It names the most common reason instead of claiming there is no server."},
  "setupLlmDiscoverUse": "Use",
  "@setupLlmDiscoverUse": {"description": "The action on a found server: it puts the address into the endpoint field and contacts it."},
  "setupLlmDiscoverAuth": "asks for credentials",
  "@setupLlmDiscoverAuth": {"description": "Badge of a server that answered with 401 or 403. It is listed, and it is not offered with a model list nobody asked it for."},
  "setupLlmDiscoverUnidentified": "did not identify itself",
  "@setupLlmDiscoverUnidentified": {"description": "Badge of a server that listens on one of the ports but answered neither API. It is listed as what it is and cannot be taken over as an endpoint."},
  "setupLlmDiscoverLatency": "{ms} ms",
  "@setupLlmDiscoverLatency": {
    "description": "How long the server took to answer the search.",
    "placeholders": {"ms": {"type": "int"}}
  },
  "setupLlmDiscoverCancel": "Stop",
  "@setupLlmDiscoverCancel": {"description": "Stops a running search. What was found stays visible."},
