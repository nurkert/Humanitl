  "setupCheckSandbox": "Sandbox check",
  "@setupCheckSandbox": {"description": "Heading of the fourth setup row: what humanitl doctor found about this machine."},
  "setupStateChecking": "asking",
  "@setupStateChecking": {"description": "The word next to the mark of a row whose answer has not arrived yet. Colour is never the only channel (docs/UX.md 3.3)."},
  "setupStateOk": "ok",
