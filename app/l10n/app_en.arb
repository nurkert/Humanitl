  "setupEvidenceChecking": "The daemon is looking.",
  "@setupEvidenceChecking": {"description": "Stands where the evidence of a row will stand while the answer is still on its way."},
  "setupEvidenceUnmeasured": "Nothing was measured here, so nothing is known either way.",
  "@setupEvidenceUnmeasured": {"description": "Stands where the evidence of a row would stand when nobody looked. It says both halves on purpose: not good, and not bad."},
  "setupEvidenceNone": "The daemon reported no detail for this line.",
  "@setupEvidenceNone": {"description": "Stands where the evidence of a row would stand when the daemon sent an empty one. Names the daemon rather than claiming there is nothing to say."},
  "setupRecheck": "Check again",
  "@setupRecheck": {"description": "Button of the sandbox row: asks the daemon to read the machine again."},
  "setupDoctorLines": "{count, plural, =1{1 line about this machine} other{{count} lines about this machine}}",
  "@setupDoctorLines": {
    "description": "Header of the foldable list under the sandbox row. Open while a line is red or unmeasured, folded while everything is green.",
