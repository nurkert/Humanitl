    "placeholders": {"key": {"type": "String"}}
  },
  "setupFixWriteEnvFailed": "Not written: {why}",
  "@setupFixWriteEnvFailed": {
    "description": "Shown under the button when the background service refused the write (CONFIG_014) or could not be reached. The copy button for the running session stays below it.",
