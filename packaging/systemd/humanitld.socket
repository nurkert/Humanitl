# humanitl daemon install: written by Humanitl
#
# Die Socket-Unit des Daemons (HUM-053, Vorlage angelegt in HUM-070).
#
# Das Paket legt sie nach `/usr/lib/systemd/user/`, ohne die Marke in der
# ersten Zeile (`packaging/deb/build-deb.sh`), und `humanitl daemon install`
# aktiviert sie dann zusammen mit dem Dienst
# (`systemctl --user enable --now humanitld.socket humanitld.service`). Ohne
# Paket schreibt der Befehl sie nicht: Dann bindet der Daemon den Socket
# selbst.
#
# systemd hält den Socket und übergibt ihn dem Dienst als Deskriptor 3
# (`LISTEN_FDS`); der Daemon übernimmt ihn, statt selbst zu binden
# (`daemon/bin/humanitld/src/systemd.rs`), und lässt die Datei beim Ende
# liegen. So bleibt der Pfad über jeden Neustart des Dienstes hinweg derselbe,
# und wer in dieser Zeit verbindet, wartet, statt abzuprallen.
#
# Der Test `the_socket_unit_listens_where_the_client_looks` misst
# `ListenStream` gegen den Pfad, an dem der Client den Socket sucht
# (`Paths::daemon_socket`), und der Daemon weist einen übergebenen Socket an
# einem anderen Pfad mit `DAEMON_013` ab.
#
# Die erste Zeile ist die Marke aus `cmd/unit.rs`: Nur eine Datei, die sie
# trägt, würde von `humanitl daemon install` je ersetzt.

[Unit]
Description=Humanitl daemon socket
Documentation=https://github.com/nurkert/Humanitl/blob/main/docs/INSTALL.md

[Socket]
# `%t` ist das Laufzeitverzeichnis des Nutzers, also `$XDG_RUNTIME_DIR`. Genau
# dort sucht der Client den Socket (`Paths::daemon_socket`).
ListenStream=%t/humanitl/daemon.sock
SocketMode=0600
DirectoryMode=0700
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
